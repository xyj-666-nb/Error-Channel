--- !u!114 &510407842
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 510407835}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6bb2d4634084bf4eb70f41fdbc44f6d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSegments:
  - segmentName: "\u65B0\u624B\u5F15\u5BFC1"
    dialogueTexts:
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u8FD9\u662F\u6211\u4EEC\u7684\u6E38\u620F\u754C\u9762"
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u6B22\u8FCE\u6765\u5230\u6211\u4EEC\u7684\u9891\u9053\uFF0C\u4F60\u9700\u8981\u6E38\u73A9\u6211\u4EEC\u7684\u6E38\u620F\u624D\u80FD\u4FEE\u597D\u8FD9\u4E2A\u7535\u89C6\u673A\uFF0C\u4F60\u4E5F\u4E0D\u60F3\u521A\u6536\u6765\u7684\u7535\u89C6\u673A\u5C31\u8FD9\u6837\u4E00\u76F4\u574F\u4E0B\u53BB\u5427\r\n"
    autoStart: 1
    onDialogueEnd:
      m_PersistentCalls:
        m_Calls: []
  - segmentName: "\u65B0\u624B\u5F15\u5BFC2"
    dialogueTexts:
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u770B\u5230\u8FD9\u4E9B\u724C\u4E86\u5417\uFF0C\u4F60\u53EF\u4EE5\u9009\u4E2D\u4ED6\u70B9\u51FB\u51FA\u53F3\u8FB9\u7684\u51FA\u724C\u952E\u81EA\u52A8\u6253\u51FA\uFF0C\u4E5F\u53EF\u4EE5\u624B\u52A8
        <color=red><b>\u62D6\u52A8</b></color>\u5230\u4E0A\u65B9\u533A\u57DF\u6253\u51FA\uFF0C\u6216
        <color=red><b>\u70B9\u51FB</b></color>\u64CD\u4F5C\u3002\r\n"
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u6E38\u620F\u7684\u73A9\u6CD5\u5C31\u662F <color=red><b>\u6BD4\u5927\u5C0F</b></color>\uFF0C\u73A9\u5BB6\u9700\u8981\u6253\u51FA\u6BD4\u76EE\u6807\u724C\u66F4\u5927\u7684\u724C\u4EE5\u83B7\u5F97\u80DC\u5229\uFF01"
    autoStart: 0
    onDialogueEnd:
      m_PersistentCalls:
        m_Calls: []
  - segmentName: "\u65B0\u624B\u5F15\u5BFC3"
    dialogueTexts:
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u6700\u4E0A\u9762\u7684\u662F\u5347\u7EA7\u5546\u5E97\uFF0C\u7528\u4E8E\u8D2D\u4E70\u5F3A\u529B\u9053\u5177\u5982\u8BA1\u7B97\u5668\uFF0C\u66F4\u591A\u624B\u724C\u7B49\uFF01"
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u8FD9\u9700\u8981\u82B1\u8D39\u60A8\u7684\u91D1\u5E01\uFF0C\u73A9\u5BB6\u6BCF\u6B21
        <color=red><b>\u80DC\u5229</b></color>\u90FD\u4F1A\u5956\u52B1\u4F60 <color=red><b>\u5BF9\u5E94\u91D1\u5E01</b></color>\uFF0C\u8D5A\u53D6\u66F4\u591A\u91D1\u5E01\u7528\u4E8E\u5E2E\u52A9\u4F60\u83B7\u5F97
        <color=red><b>\u80DC\u5229</b></color>\u5427"
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u770B\u5230\u7B2C\u4E8C\u4E2A\u6309\u94AE\u4E86\u5417\uFF0C\u8FD9\u662F
        <color=red><b>\u4FEE\u590D\u5546\u5E97</b></color>\uFF0C\u662F\u73A9\u5BB6\u7684
        <color=red><b>\u4E3B\u8981\u76EE\u6807</b></color>\uFF01\u7535\u89C6\u673A\u5B58\u5728\u7684\u5404\u79CD
        Bug \u90FD\u53EF\u4EE5\u5728\u8FD9\u91CC\u7528\u96F6\u4EF6\u6765\u4FEE\u590D\uFF01\r\n"
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u6700\u540E\u4E00\u4E2A\u9000\u51FA\u6309\u94AE\u597D\u50CF\u65E0\u6CD5\u4EA4\u4E92\uFF0C\u770B\u6765\u4E5F\u662F\u635F\u574F\u4E86\uFF01"
    autoStart: 0
    onDialogueEnd:
      m_PersistentCalls:
        m_Calls: []
  - segmentName: "\u65B0\u624B\u5F15\u5BFC4"
    dialogueTexts:
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u6700\u4E0A\u9762\u7684\u724C\u5B50\u663E\u793A\u7684\u662F\u5F53\u524D\u7684\u6E38\u620F\u96BE\u5EA6\uFF0C\u6E38\u620F\u96BE\u5EA6\u8D8A\u9AD8\u83B7\u5F97\u7684\u5956\u52B1\u8D8A\u4E30\u5BCC\uFF0C\u73A9\u5BB6\u53EF\u4EE5\u5728\u5347\u7EA7\u5546\u5E97\u5904\u7528\u91D1\u5E01\u8FDB\u884C\u5347\u7EA7"
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u53F3\u8FB9\u7684\u4E24\u4E2A\u8FDB\u5EA6\u6761\u4E00\u4E2A\u662F\u73A9\u5BB6\u7684\u8840\u91CF\uFF0C\u4E00\u4E2A\u662F\u7528\u6765\u663E\u793A\u5F53\u524D\u4FEE\u590D\u8FDB\u5EA6\u7684"
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u5F53\u524D\u7684\u73A9\u5BB6\u8840\u91CF\u770B\u8D77\u6765\u4E0D\u662F\u5F88\u6B63\u5E38\uFF0C\u8BF7\u4F60\u52A1\u5FC5\u5C0F\u5FC3\u5931\u8D25\uFF01\u5C3D\u5FEB\u4FEE\u590D\u8FD9\u4E2Abug"
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u4FEE\u590D\u7684\u8FDB\u5EA6\u6761\u901A\u8FC7\u5728\u4FEE\u7406\u5546\u5E97\u4FEE\u590Dbg\u83B7\u5F97\uFF0C\u4FEE\u590D\u8FDB\u5EA6\u8FBE\u5230100%\u6E38\u620F\u80DC\u5229\uFF01"
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u4E0B\u9762\u91D1\u5E93\u65C1\u7684\u96F6\u4EF6\u6761\u770B\u5230\u4E86\u5417\uFF0C\u8FD9\u91CC\u663E\u793A\u7684\u662F\u73A9\u5BB6\u83B7\u53D6\u96F6\u4EF6\u7684\u8FDB\u5EA6\uFF0C\u5F53\u73A9\u5BB6\u8FBE\u52303\u6B21\u7EC3\u80DC\u7684\u65F6\u5019\u5C31\u4F1A\u5F00\u59CB\u6FC0\u6D3B\u96F6\u4EF6\u83B7\u53D6\uFF0C\u4E4B\u540E\u6BCF\u6B21\u80DC\u5229\u90FD\u4F1A\u83B7\u5F971\u4E2A\uFF0C\u4F46\u662F\u5931\u8D25\u5C31\u4F1A\u91CD\u7F6E\uFF01"
    autoStart: 0
    onDialogueEnd:
      m_PersistentCalls:
        m_Calls: []
  - segmentName: "\u65B0\u624B\u5F15\u5BFC5"
    dialogueTexts:
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u8FD9\u91CC\u6709\u4E00\u4E2A\u8C03\u8282\u97F3\u91CF\u7684\u65CB\u94AE\uFF0C\u73A9\u5BB6\u53EF\u4EE5\u901A\u8FC7\u8FD9\u4E2A\u6765\u8C03\u8282\u6E38\u620F\u7684\u97F3\u6548\u548C\u80CC\u666F\u97F3\u4E50\u7684\u5927\u5C0F"
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u9047\u5230\u4F60\u624B\u724C\u4E2D\u6CA1\u6709\u80FD\u6BD4\u5BF9\u7684\u6570\u5B57\u662F\uFF0C\u4F60\u53EF\u4EE5\u4F7F\u7528\u8DF3\u8FC7\u529F\u80FD\uFF0C\u5C31\u662F\u7EA2\u8272\u7684\u6309\u94AE\uFF0C\u73A9\u5BB6\u6BCF\u8F6E\u6709\u4E00\u6B21\u514D\u8D39\u7684\u673A\u4F1A\u8FDB\u884C\u6362\u724C\uFF0C\u9009\u5B9A\u4F60\u8981\u66F4\u6362\u7684\u724C\u7136\u540E\u70B9\u51FB\u8FD9\u4E2A\u7EA2\u8272\u6309\u94AE\u5373\u53EF\uFF0C\u4E4B\u540E\u5982\u679C\u8981\u7EE7\u7EED\u4F7F\u7528\u8FD9\u4E2A\u529F\u80FD\u5219\u9700\u8981\u81EA\u6263\u4E00\u6EF4\u8840"
    - speakerName: "\u795E\u79D8\u4EBA"
      content: "\u4F7F\u7528\u597D\u8FD9\u4E2A\u66F4\u6362\u6309\u94AE\u53EF\u4EE5\u5E2E\u52A9\u4F60\u66F4\u5BB9\u6613\u7684\u83B7\u53D6\u80DC\u5229\uFF01"
    autoStart: 0
    onDialogueEnd:
      m_PersistentCalls:
        m_Calls: []
  enableDebug: 1
